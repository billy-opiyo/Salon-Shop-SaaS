{
	"name": "salon-shop-saas",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "node node_modules/next/dist/bin/next dev frontend",
		"prebuild": "npm run db:generate",
		"build": "node node_modules/next/dist/bin/next build frontend",
		"start": "node node_modules/next/dist/bin/next start frontend",
		"lint": "node node_modules/eslint/bin/eslint.js frontend --config frontend/eslint.config.mjs",
		"test:e2e": "playwright test",
		"test:unit": "vitest run",
		"check": "npm run lint && npm run test:unit && npm run build",
		"db:format": "node node_modules/prisma/build/index.js format --schema prisma/schema.prisma",
		"db:validate": "node node_modules/prisma/build/index.js validate --schema prisma/schema.prisma",
		"db:generate": "node node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
		"android:add": "node scripts/android-build.mjs staging add",
		"android:sync": "node scripts/android-build.mjs staging sync",
		"android:sync:production": "node scripts/android-build.mjs production sync",
		"android:debug": "node scripts/android-build.mjs staging debug",
		"android:release:apk": "node scripts/android-build.mjs production release-apk",
		"android:release:aab": "node scripts/android-build.mjs production release-aab",
		"android:validate:staging": "node scripts/android-build.mjs staging validate",
		"android:validate:production": "node scripts/android-build.mjs production validate",
		"db:migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma"
	},
	"dependencies": {
		"@auth/prisma-adapter": "2.11.3",
		"@aws-sdk/client-s3": "^3.859.0",
		"@aws-sdk/s3-request-presigner": "^3.859.0",
		"@capacitor/app": "8.1.2",
		"@capacitor/browser": "8.0.5",
		"@capacitor/core": "8.5.3",
		"@prisma/client": "6.12.0",
		"bcryptjs": "3.0.3",
		"lucide-react": "^1.61.0",
		"next": "16.3.2",
		"next-auth": "5.0.0-beta.32",
		"prisma": "6.12.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"server-only": "0.0.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@capacitor/android": "8.5.3",
		"@capacitor/cli": "8.5.3",
		"@playwright/test": "^1.62.1",
		"@types/node": "20.19.43",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"eslint": "9.39.5",
		"eslint-config-next": "16.3.2",
		"typescript": "5.9.3",
		"vitest": "^4.1.11"
	}
}
