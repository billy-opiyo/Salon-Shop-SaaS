# The application URL must use the new SaaS environment, never the Firebase app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon pooled runtime connection. Use a host containing -pooler.
DATABASE_URL=

# Auth.js (server-only; add when authentication is implemented)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudflare Turnstile (server secret is never public)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare R2 (server-only; add when media is implemented)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Resend and WhatsApp Cloud API (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
