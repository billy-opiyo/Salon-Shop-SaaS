# The application URL must use the new SaaS environment, never the Firebase app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Android builds always require an explicit target. Staging is pinned in
# scripts/android-build.mjs. Set this only after Beauty Sphia production is deployed.
BEAUTY_SPHIA_PRODUCTION_URL=
# Production releases are blocked unless deliberately enabled after launch approval.
BEAUTY_SPHIA_PRODUCTION_RELEASE_ENABLED=0
# Production signing inputs (outside git; never place the keystore in this repository).
BEAUTY_SPHIA_ANDROID_KEYSTORE=
BEAUTY_SPHIA_ANDROID_STORE_PASSWORD=
BEAUTY_SPHIA_ANDROID_KEY_ALIAS=
BEAUTY_SPHIA_ANDROID_KEY_PASSWORD=
BEAUTY_SPHIA_ANDROID_EXPECTED_CERT_SHA256=
# Optional path to a downloaded bundletool JAR for production AAB verification.
BUNDLETOOL_JAR=

# Optional custom-domain provider integration. Configure these before production activation.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# Optional: only needed when Cloudflare DNS is managed by this application.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Neon pooled runtime connection. Use a host containing -pooler.
DATABASE_URL=

# Auth.js (server-only; add when authentication is implemented)
AUTH_SECRET=
# These environment allowlists define full platform Owner accounts. Delegate
# limited Store Editor/Store Support access from the Owner-only Platform Admin page.
PLATFORM_ADMIN_EMAILS=
PLATFORM_ADMIN_USER_IDS=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudflare Turnstile (server secret is never public)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare R2 (server-only; add when media is implemented)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Resend (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=


# Africa's Talking sandbox. Keep sandbox credentials here for local staging tests.
SMS_PROVIDER_URL=https://api.sandbox.africastalking.com/version1/messaging
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_USERNAME=sandbox
SMS_SENDER_ID=

# WhatsApp Cloud API
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# Safaricom Daraja STK Push (server-only)
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=http://localhost:3000/api/billing/daraja/callback

# Shared secret required by scheduled endpoints (/api/cron/*).
# Vercel Cron sends it automatically as an Authorization Bearer header.
CRON_SECRET=
