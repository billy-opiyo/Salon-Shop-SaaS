generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  STARTER
  BUSINESS
  ENTERPRISE
}

enum TenantStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  COMPLETED
  CANCELLED
}

enum WaitlistStatus {
  WAITING
  CONTACTED
  BOOKED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageStatus {
  NEW
  READ
  RESOLVED
}

enum MediaKind {
  LOGO
  HERO
  GALLERY
  BLOG
  REVIEW
  AVATAR
  BOOKING_INSPIRATION
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  emailVerified          DateTime?
  passwordHash           String?
  name                   String?
  phone                  String?
  image                  String?
  blockedUntil           DateTime?
  passwordResetRequired  Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  accounts               Account[]
  sessions               Session[]
  ownedTenants           Tenant[]               @relation("TenantOwner")
  memberships            Membership[]
  bookings               Booking[]
  waitlistEntries        WaitlistEntry[]
  reviews                Review[]
  favorites              Favorite[]
  contactMessages        ContactMessage[]
  loginActivities        LoginActivity[]
  securityAlerts         SecurityAlert[]
  accountChanges         AccountChangeHistory[]
  activityTimeline       ActivityTimeline[]
  auditLogs              AdminAuditLog[]
  mediaAssets            MediaAsset[]
  notificationDeliveries NotificationDelivery[]
  preferences            UserPreferences?
  createdAttributions    Tenant[]               @relation("TenantCreatedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserPreferences {
  id            String   @id @default(cuid())
  userId        String   @unique
  theme         String   @default("dark")
  fontSize      String   @default("medium")
  highContrast  Boolean  @default(false)
  reducedMotion Boolean  @default(false)
  notifyEmail   Boolean  @default(true)
  notifySms     Boolean  @default(false)
  notifyPush    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id              String                 @id @default(cuid())
  slug            String                 @unique
  businessName    String
  status          TenantStatus           @default(DRAFT)
  country         String                 @default("Kenya")
  city            String?
  timezone        String                 @default("Africa/Nairobi")
  locale          String                 @default("en-KE")
  currency        String                 @default("KES")
  ownerUserId     String
  createdByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  owner           User                   @relation("TenantOwner", fields: [ownerUserId], references: [id])
  createdBy       User?                  @relation("TenantCreatedBy", fields: [createdByUserId], references: [id])
  domains         TenantDomain[]
  settings        TenantSettings?
  memberships     Membership[]
  subscription    Subscription?
  categories      ServiceCategory[]
  services        Service[]
  stylists        Stylist[]
  galleryStyles   GalleryStyle[]
  blogPosts       BlogPost[]
  bookingSlots    BookingSlot[]
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  reviews         Review[]
  favorites       Favorite[]
  contactMessages ContactMessage[]
  mediaAssets     MediaAsset[]
  notifications   NotificationDelivery[]
  rateLimits      RateLimitRecord[]
  loginActivities LoginActivity[]
  alerts          SecurityAlert[]
  accountChanges  AccountChangeHistory[]
  timeline        ActivityTimeline[]
  auditLogs       AdminAuditLog[]

  @@index([ownerUserId])
  @@index([status])
}

model TenantDomain {
  id         String    @id @default(cuid())
  tenantId   String
  host       String    @unique
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantSettings {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  themePreset       String   @default("gold")
  themeMode         String   @default("dark")
  logoUrl           String?
  heroImageUrl      String?
  phonePrimary      String?
  phoneSecondary    String?
  whatsappUrl       String?
  emailPrimary      String?
  emailBookings     String?
  address           String?
  openingHours      Json?
  socialLinks       Json?
  seo               Json?
  legal             Json?
  featureFlags      Json?
  serviceVisibility Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Plan {
  id            String         @id @default(cuid())
  tier          PlanTier       @unique
  displayName   String
  entitlements  Json
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id                     String    @id @default(cuid())
  tenantId               String    @unique
  planId                 String
  status                 String    @default("trialing")
  externalCustomerId     String?
  externalSubscriptionId String?   @unique
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                   Plan      @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
}

model Membership {
  id                String           @id @default(cuid())
  tenantId          String
  userId            String
  role              MembershipRole   @default(STAFF)
  status            MembershipStatus @default(ACTIVE)
  canManageAdmins   Boolean          @default(false)
  canManageBookings Boolean          @default(false)
  canManageContent  Boolean          @default(false)
  canManageSecurity Boolean          @default(false)
  invitedAt         DateTime?
  joinedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, status])
}

model ServiceCategory {
  id            String         @id @default(cuid())
  tenantId      String
  key           String
  label         String
  shortLabel    String?
  enabled       Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services      Service[]
  galleryStyles GalleryStyle[]

  @@unique([tenantId, key])
  @@index([tenantId, enabled, sortOrder])
}

model Service {
  id            String          @id @default(cuid())
  tenantId      String
  categoryId    String
  name          String
  slug          String
  description   String          @db.Text
  priceLabel    String
  durationLabel String
  orderOnly     Boolean         @default(false)
  enabled       Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bookings      Booking[]

  @@unique([tenantId, slug])
  @@index([tenantId, enabled, sortOrder])
  @@index([categoryId])
}

model Stylist {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  title     String?
  email     String?
  phone     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@index([tenantId, active])
}

model GalleryStyle {
  id                 String           @id @default(cuid())
  tenantId           String
  categoryId         String?
  styleName          String
  description        String?          @db.Text
  serviceName        String?
  styleType          String?
  length             String?
  size               String?
  hairType           String?
  stylistName        String?
  timeTaken          String?
  priceRange         String?
  imageUrl           String
  beforeImageUrl     String?
  featuredTrending   Boolean          @default(false)
  featuredMostBooked Boolean          @default(false)
  published          Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category           ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  favorites          Favorite[]

  @@index([tenantId, published, updatedAt])
  @@index([tenantId, featuredTrending])
  @@index([tenantId, featuredMostBooked])
}

model BlogPost {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  slug        String
  excerpt     String   @db.Text
  imageUrl    String?
  readTime    String?
  publishDate DateTime
  readMoreUrl String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, published, publishDate])
}

model BookingSlot {
  id          String    @id @default(cuid())
  tenantId    String
  slotKey     String
  date        DateTime  @db.Date
  timeLabel   String
  bookingId   String?   @unique
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking     Booking?  @relation("BookingSlot", fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slotKey])
  @@index([tenantId, date])
}

model Booking {
  id                  String                 @id @default(cuid())
  tenantId            String
  userId              String?
  serviceId           String?
  stylistId           String?
  firstName           String
  lastName            String
  email               String
  phone               String
  serviceName         String
  customService       String?
  appointmentDate     DateTime               @db.Date
  timeLabel           String
  status              BookingStatus          @default(PENDING)
  specialRequests     String?                @db.Text
  inspirationImageUrl String?
  releasedSlotId      String?
  slotReleasedAt      DateTime?
  slotReleaseReason   String?
  slotReleaseSource   String?
  slotReleasedBy      String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  service             Service?               @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  stylist             Stylist?               @relation(fields: [stylistId], references: [id], onDelete: SetNull)
  bookingSlot         BookingSlot?           @relation("BookingSlot")
  waitlistEntry       WaitlistEntry?         @relation("WaitlistBooking")
  notifications       NotificationDelivery[]

  @@index([tenantId, status, appointmentDate])
  @@index([tenantId, email])
  @@index([userId, appointmentDate])
}

model WaitlistEntry {
  id               String         @id @default(cuid())
  tenantId         String
  userId           String?
  linkedBookingId  String?        @unique
  serviceName      String
  preferredDate    DateTime?      @db.Date
  preferredTime    String?
  preferredStylist String?
  email            String
  phone            String
  queuePosition    Int            @default(0)
  status           WaitlistStatus @default(WAITING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  linkedBooking    Booking?       @relation("WaitlistBooking", fields: [linkedBookingId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, queuePosition])
  @@index([userId, status])
}

model Review {
  id           String       @id @default(cuid())
  tenantId     String
  userId       String
  name         String
  rating       Int
  serviceName  String?
  text         String       @db.Text
  photoUrl     String?
  status       ReviewStatus @default(PENDING)
  featured     Boolean      @default(false)
  replyText    String?      @db.Text
  reportsCount Int          @default(0)
  editedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([userId, createdAt])
}

model Favorite {
  id             String       @id @default(cuid())
  tenantId       String
  userId         String
  galleryStyleId String
  createdAt      DateTime     @default(now())
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  galleryStyle   GalleryStyle @relation(fields: [galleryStyleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, galleryStyleId])
  @@index([userId, tenantId])
}

model ContactMessage {
  id        String        @id @default(cuid())
  tenantId  String
  userId    String?
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
}

model MediaAsset {
  id           String    @id @default(cuid())
  tenantId     String
  uploadedById String?
  kind         MediaKind
  objectKey    String
  publicUrl    String?
  mimeType     String
  byteSize     Int
  width        Int?
  height       Int?
  createdAt    DateTime  @default(now())
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, objectKey])
  @@index([tenantId, kind, createdAt])
}

model NotificationDelivery {
  id                String              @id @default(cuid())
  tenantId          String
  userId            String?
  bookingId         String?
  channel           NotificationChannel
  templateKey       String
  destination       String
  idempotencyKey    String              @unique
  providerMessageId String?
  status            NotificationStatus  @default(PENDING)
  errorMessage      String?             @db.Text
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking           Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([tenantId, channel, status, createdAt])
  @@index([bookingId])
}

model RateLimitRecord {
  id          String   @id @default(cuid())
  tenantId    String?
  scopeKey    String   @unique
  subjectKey  String
  kind        String
  availableAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, subjectKey, kind])
  @@index([availableAt])
}

model LoginActivity {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  email     String?
  provider  String
  status    String
  riskLevel String?
  riskScore Int?
  ipHash    String?
  userAgent String?
  country   String?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model SecurityAlert {
  id         String    @id @default(cuid())
  tenantId   String?
  userId     String?
  severity   String
  alertType  String
  message    String    @db.Text
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, severity, resolvedAt, createdAt])
}

model AccountChangeHistory {
  id          String   @id @default(cuid())
  tenantId    String?
  userId      String?
  actorUserId String?
  changeType  String
  summary     String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model ActivityTimeline {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  eventType String
  summary   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, eventType, createdAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  tenantId     String?
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
}
